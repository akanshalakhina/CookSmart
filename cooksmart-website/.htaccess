# CookSmart — Apache configuration (shared hosting)
# If the site lives in a sub-folder, change ErrorDocument to /sub-folder/404.php.

Options -Indexes
DirectoryIndex index.php
AddDefaultCharset UTF-8
ErrorDocument 404 /404.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block private folders
    RewriteRule ^(includes|data|storage)(/|$) - [F,L]

    # Redirect old-style .php URLs to clean URLs (SEO)
    RewriteCond %{THE_REQUEST} \s/+(about-us|products|company-policy|contact-us)\.php[\s?] [NC]
    RewriteRule ^ %1/ [R=301,L]

    # Clean URLs (same slugs as the future WordPress pages)
    RewriteRule ^about-us/?$             about-us.php        [L,QSA]
    RewriteRule ^products/?$             products.php        [L,QSA]
    RewriteRule ^products/([a-z0-9-]+)/?$ product.php?slug=$1 [L,QSA]
    RewriteRule ^company-policy/?$       company-policy.php  [L,QSA]
    RewriteRule ^contact-us/?$           contact-us.php      [L,QSA]
    RewriteRule ^sitemap\.xml$           sitemap.php         [L]
</IfModule>

# Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json text/xml application/xml
</IfModule>

# Browser caching (asset URLs carry ?v= cache-busting)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
</IfModule>
